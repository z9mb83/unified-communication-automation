# New sender image = the current live email-sender image + the master-sheet changes.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY app/config_loader.py app/limit_manager.py app/brand_runner.py app/send_now.py app/email_generator.py app/domain_check.py app/regenerate.py app/sheet_client.py app/reply_sync.py app/
COPY main.py ./
COPY brands_master/ brands_master/
COPY daily_report.py report_core.py reply_sheet.py test_daily_report.py test_mail_limits.py test_send_now.py test_email_generator.py test_domain_check.py test_regenerate.py test_sheet_retry.py test_reply_sync.py ./
RUN python -m unittest test_mail_limits test_daily_report test_send_now test_email_generator test_domain_check test_regenerate test_sheet_retry test_reply_sync
