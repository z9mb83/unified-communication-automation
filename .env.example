# Copy to .env for LOCAL development only. Every value here is a placeholder.
# In Cloud Run these are set as environment variables; secrets come from Secret Manager.

UCA_ENV=local                       # local | test | staging | production
UCA_SERVICE_ROLE=api                # api | webhooks | workers (all = local only)
UCA_STORE_BACKEND=memory            # firestore in staging/production
UCA_QUEUE_BACKEND=inline            # cloudtasks in staging/production
UCA_CONFIG_DIR=./config             # brands.yaml, sheets.yaml, channels.yaml, access.yaml
UCA_FIRESTORE_PREFIX=uca_

UCA_GCP_PROJECT=your-gcp-project-id
UCA_GCP_REGION=asia-south1
UCA_TASKS_LOCATION=asia-south1
UCA_QUEUE_EMAIL=uca-email
UCA_QUEUE_WHATSAPP=uca-whatsapp
UCA_QUEUE_SMS=uca-sms
UCA_QUEUE_RECONCILIATION=uca-reconciliation
UCA_WORKER_BASE_URL=https://uca-workers-XXXXXXXX-el.a.run.app
UCA_TASKS_INVOKER_SA=uca-tasks-invoker@your-gcp-project-id.iam.gserviceaccount.com
UCA_WORKER_ALLOWED_CALLERS=uca-tasks-invoker@your-gcp-project-id.iam.gserviceaccount.com

# Apps Script OAuth client ID (audience of ScriptApp.getIdentityToken())
UCA_ALLOWED_AUDIENCES=1234567890-xxxxxxxx.apps.googleusercontent.com
UCA_REQUEST_MAX_AGE_SECONDS=300

# Existing email automation
UCA_EMAIL_SERVICE_DIR=./services/email
UCA_EMAIL_RUN_JOB_NAME=email-sender       # existing Cloud Run job; only triggered, never redeployed
STATE_BACKEND=firestore                   # existing email app setting
RUNTIME_ENV=cloud_run                     # existing email app: log to stdout
GMAIL_TOKEN_BUNDLE_FILE=/secrets/gmail/bundle.json   # Secret Manager volume mount (existing secret)
OPENAI_API_KEY=                           # set from Secret Manager, never here
OPENAI_MODEL=gpt-5-mini
TIMEZONE=Asia/Kolkata

# Local development only (rejected in staging/production)
UCA_AUTH_DISABLED_FOR_LOCAL=false
