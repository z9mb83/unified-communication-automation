# Settings read by the email tool. Placeholders only — never put real keys here.
# On Cloud Run these are set as job environment variables / Secret Manager mounts.

RUNTIME_ENV=cloud_run                         # cloud_run = log to stdout
STATE_BACKEND=firestore                       # run lock + send log in Firestore
TIMEZONE=Asia/Kolkata
OPENAI_API_KEY=                               # from Secret Manager, never typed here
OPENAI_MODEL=gpt-5-mini
GMAIL_TOKEN_BUNDLE_FILE=/secrets/gmail/bundle.json   # Gmail tokens (secret gmail-oauth-bundle)
MAX_DRAFTS_PER_BRAND_PER_RUN=20
CROSS_BRAND_DUPLICATE_DAYS=0

# Only needed on your own computer when reconnecting a Gmail mailbox:
GOOGLE_OAUTH_CLIENT_FILE=credentials.json
